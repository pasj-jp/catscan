# Reference snapshots and upstream source trees kept for local reference only.
/reference/

# Secrets and machine-specific environment files.
.env
.env.*
!.env.example
!.env.*.example

# macOS, Windows, and editor metadata.
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Frontend dependencies, build output, and local tool state.
/frontend/node_modules/
/frontend/.pnp/
/frontend/.pnp.*
/frontend/coverage/
/frontend/dist/
/frontend/build/
/frontend/.vite/
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*

# Backend Python environments, caches, and build output.
/backend/.venv/
/backend/venv/
/backend/env/
/backend/ENV/
/backend/__pycache__/
/backend/**/__pycache__/
/backend/.pytest_cache/
/backend/.mypy_cache/
/backend/.ruff_cache/
/backend/.coverage
/backend/htmlcov/
/backend/build/
/backend/dist/
/backend/*.egg-info/
/backend/**/*.egg-info/
/backend/*.log

# Generated validation reports; preserve the directory marker if present.
/backend/data/reports/*.json
!/backend/data/reports/.gitkeep

# Plugins build artifacts and cache
/plugins/**/__pycache__/
/plugins/**/*.egg-info/
/plugins/**/build/
/plugins/**/dist/


